    .sizes{display:flex;gap:8px;flex-wrap:wrap;}
    .size-btn{width:52px;height:52px;display:flex;align-items:center;justify-content:center;font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;background:transparent;border:1px solid rgba(10,10,10,.15);cursor:none;transition:all .2s;}
    .size-btn:hover:not(.soldout){background:var(--noir);color:var(--blanc);border-color:var(--noir);}
    .size-btn.active{background:var(--noir);color:var(--blanc);border-color:var(--noir);}
    .size-btn.soldout{opacity:.3;cursor:not-allowed;text-decoration:line-through;}
    .size-guide{font-size:12px;color:var(--vert);text-decoration:none;font-weight:500;margin-top:8px;display:inline-block;}

    .qty-row{display:flex;align-items:center;gap:12px;margin-bottom:24px;}
    .qty-ctrl{display:flex;align-items:center;border:1px solid rgba(10,10,10,.15);}
    .qty-btn{width:44px;height:44px;background:none;border:none;font-size:20px;cursor:none;display:flex;align-items:center;justify-content:center;transition:background .2s;color:var(--noir);}
    .qty-btn:hover{background:rgba(10,10,10,.05);}
    .qty-num{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:18px;width:44px;text-align:center;border-left:1px solid rgba(10,10,10,.1);border-right:1px solid rgba(10,10,10,.1);}

    .cta-row{display:flex;flex-direction:column;gap:10px;margin-bottom:28px;}
    .btn-add{width:100%;padding:17px;background:var(--noir);color:var(--blanc);font-family:'Barlow Condensed',sans-serif;font-size:15px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;border:none;cursor:none;transition:background .2s;}
    .btn-add:hover{background:var(--vert);}
    .btn-buy{width:100%;padding:17px;background:var(--terre);color:var(--blanc);font-family:'Barlow Condensed',sans-serif;font-size:15px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;border:none;cursor:none;transition:background .2s;}
    .btn-buy:hover{background:#a8642e;}

    .reassurance{display:flex;flex-direction:column;gap:0;border:1px solid rgba(10,10,10,.08);margin-bottom:32px;}
    .reassurance-item{display:flex;align-items:center;gap:14px;padding:14px 16px;border-bottom:1px solid rgba(10,10,10,.06);font-size:13px;color:#666;}
    .reassurance-item:last-child{border-bottom:none;}
    .reassurance-item .icon{font-size:18px;width:24px;text-align:center;flex-shrink:0;}
    .reassurance-item strong{color:var(--noir);}

    .accordion{border-top:1px solid rgba(10,10,10,.1);}
    .accordion-item{border-bottom:1px solid rgba(10,10,10,.08);}
    .accordion-header{display:flex;align-items:center;justify-content:space-between;padding:18px 0;cursor:none;}
    .accordion-header h4{font-size:13px;font-weight:600;letter-spacing:.04em;}
    .accordion-arrow{font-size:18px;color:var(--gris);transition:transform .3s;}
    .accordion-item.open .accordion-arrow{transform:rotate(180deg);}
    .accordion-body{display:none;padding-bottom:18px;}
    .accordion-item.open .accordion-body{display:block;}
    .accordion-body p,.accordion-body li{font-size:13px;color:#777;line-height:1.8;}
    .accordion-body ul{list-style:none;display:flex;flex-direction:column;gap:6px;}
    .accordion-body ul li::before{content:'—';color:var(--terre);margin-right:8px;}
    .specs-table{width:100%;border-collapse:collapse;}
    .specs-table tr td{padding:8px 0;font-size:13px;border-bottom:1px solid rgba(10,10,10,.05);}
    .specs-table tr td:first-child{color:#aaa;text-transform:uppercase;font-size:11px;letter-spacing:.07em;width:40%;}
    .specs-table tr td:last-child{font-weight:600;color:var(--noir);}

    #toast{position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:var(--noir);color:var(--blanc);font-size:13px;letter-spacing:.06em;padding:14px 28px;z-index:9999;opacity:0;transition:opacity .3s;pointer-events:none;white-space:nowrap;}
    .cart-overlay{position:fixed;inset:0;background:rgba(10,10,10,.5);z-index:800;opacity:0;pointer-events:none;transition:opacity .3s;}
