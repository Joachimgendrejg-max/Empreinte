    .kit-contents{background:rgba(10,10,10,.03);border:1px solid rgba(10,10,10,.08);padding:20px 24px;margin-bottom:28px;}
    .kit-contents-title{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--noir);margin-bottom:14px;}
    .kit-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(10,10,10,.06);font-size:13px;color:#555;}
    .kit-item:last-child{border-bottom:none;}
    .kit-item-check{width:18px;height:18px;background:var(--vert);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;flex-shrink:0;}
    .kit-item-info{flex:1;}
    .kit-item-price{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:15px;color:#aaa;}

    .option-block{margin-bottom:24px;}
