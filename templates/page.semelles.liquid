  <script>
    const cursor=document.getElementById('cursor'),ring=document.getElementById('cursorRing');
    let mx=0,my=0,rx=0,ry=0;
    document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});
    function anim(){cursor.style.left=mx+'px';cursor.style.top=my+'px';rx+=(mx-rx)*.14;ry+=(my-ry)*.14;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(anim);}
    anim();
    document.querySelectorAll('a,button').forEach(el=>{
      el.addEventListener('mouseenter',()=>{cursor.style.width='6px';cursor.style.height='6px';ring.style.width='52px';ring.style.height='52px';});
      el.addEventListener('mouseleave',()=>{cursor.style.width='10px';cursor.style.height='10px';ring.style.width='36px';ring.style.height='36px';});
    });

    function addToCart(name, price) {
      let cart = JSON.parse(localStorage.getItem('empreinte-cart') || '[]');
      const existing = cart.find(i => i.name === name);
      if (existing) { existing.qty++; } else { cart.push({ name, price, qty: 1 }); }
      localStorage.setItem('empreinte-cart', JSON.stringify(cart));
      updateCartBadge();
      showToast(name + ' ajouté au panier');
    }
    function updateCartBadge() {
      const cart = JSON.parse(localStorage.getItem('empreinte-cart') || '[]');
      const total = cart.reduce((s,i)=>s+i.qty,0);
      document.querySelectorAll('.cart-count').forEach(el => el.textContent = total > 0 ? total : '');
    }
    function showToast(msg) {
      let t = document.getElementById('toast');
      if (!t) { t = document.createElement('div'); t.id = 'toast'; t.style.cssText='position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:#0A0A0A;color:#F5F2ED;font-family:DM Sans,sans-serif;font-size:13px;letter-spacing:.06em;padding:14px 28px;z-index:9999;opacity:0;transition:opacity .3s;'; document.body.appendChild(t); }
      t.textContent = msg; t.style.opacity = '1';
      setTimeout(() => t.style.opacity = '0', 2500);
    }
    updateCartBadge();
  </script>
