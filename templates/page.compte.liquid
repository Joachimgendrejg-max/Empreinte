<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mon Compte — EMPREINTE</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,300;0,400;0,700;0,800;0,900;1,700;1,900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root{--noir:#0A0A0A;--blanc:#F5F2ED;--terre:#C47A3A;--vert:#2E5C3A;--gris:#888;}
    html{scroll-behavior:smooth;}
    body{font-family:'DM Sans',sans-serif;background:var(--blanc);color:var(--noir);overflow-x:hidden;cursor:none;min-height:100vh;}
    .cursor{width:10px;height:10px;background:var(--terre);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .2s,height .2s;}
    .cursor-ring{width:36px;height:36px;border:1px solid rgba(196,122,58,.5);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:all .12s ease-out;}
    nav{position:fixed;top:0;left:0;right:0;z-index:500;display:flex;align-items:center;justify-content:space-between;padding:0 40px;height:64px;background:rgba(10,10,10,.92);backdrop-filter:blur(12px);border-bottom:1px solid #1a1a1a;}
    .nav-logo{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:20px;letter-spacing:.18em;text-transform:uppercase;color:var(--blanc);text-decoration:none;}
    .nav-center{display:flex;align-items:center;gap:32px;}
    .nav-link{font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,242,237,.5);text-decoration:none;transition:color .2s;}
    .nav-link:hover,.nav-link.active{color:var(--blanc);}
    .nav-right{display:flex;align-items:center;gap:4px;}
    .nav-icon{width:40px;height:40px;display:flex;align-items:center;justify-content:center;color:rgba(245,242,237,.6);text-decoration:none;transition:color .2s;position:relative;}
    .nav-icon:hover{color:var(--blanc);}
    .cart-badge{background:var(--terre);color:#fff;border-radius:50%;width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;font-size:8px;font-weight:900;position:absolute;top:5px;right:3px;}

    /* LAYOUT */
    .page{padding-top:64px;display:grid;grid-template-columns:280px 1fr;min-height:100vh;}

    /* SIDEBAR */
    .sidebar{background:var(--noir);padding:48px 32px;border-right:1px solid #1a1a1a;position:sticky;top:64px;height:calc(100vh - 64px);}
    .sidebar-user{margin-bottom:40px;padding-bottom:32px;border-bottom:1px solid #1a1a1a;}
    .user-avatar{width:48px;height:48px;background:var(--vert);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:20px;color:var(--blanc);margin-bottom:12px;}
    .user-name{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:18px;text-transform:uppercase;color:var(--blanc);letter-spacing:.04em;}
    .user-email{font-size:12px;color:#555;margin-top:4px;}
    .sidebar-nav{display:flex;flex-direction:column;gap:4px;}
    .sidebar-link{display:flex;align-items:center;gap:12px;padding:12px 16px;font-size:13px;font-weight:500;color:#555;text-decoration:none;transition:all .2s;letter-spacing:.04em;}
    .sidebar-link:hover{color:var(--blanc);background:rgba(255,255,255,.04);}
    .sidebar-link.active{color:var(--blanc);background:rgba(255,255,255,.06);border-left:2px solid var(--terre);}
    .sidebar-link .icon{font-size:16px;width:20px;text-align:center;}
    .sidebar-logout{margin-top:auto;padding-top:32px;border-top:1px solid #1a1a1a;position:absolute;bottom:32px;left:32px;right:32px;}
    .logout-btn{width:100%;padding:12px;background:transparent;border:1px solid #1a1a1a;color:#555;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:none;transition:all .2s;}
    .logout-btn:hover{border-color:#333;color:#888;}

    /* CONTENT */
    .content{padding:56px 64px;}
    .section-title{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(36px,4vw,52px);text-transform:uppercase;line-height:.95;margin-bottom:8px;}
    .section-title em{font-style:italic;color:var(--terre);}
    .section-sub{font-size:14px;color:var(--gris);margin-bottom:48px;}

    /* VUE: LOGIN */
    #view-login,.view-section{display:none;}
    #view-login.active,.view-section.active{display:block;}

    .login-wrap{max-width:480px;}
    .form-tabs{display:flex;gap:0;margin-bottom:40px;border-bottom:1px solid rgba(10,10,10,.1);}
    .form-tab{padding:12px 24px;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;background:none;border:none;color:#aaa;cursor:none;transition:color .2s;border-bottom:2px solid transparent;margin-bottom:-1px;}
    .form-tab.active{color:var(--noir);border-bottom-color:var(--terre);}
    .form-group{margin-bottom:20px;}
    .form-group label{display:block;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gris);margin-bottom:8px;}
    .form-group input{width:100%;padding:14px 16px;background:transparent;border:1px solid rgba(10,10,10,.15);font-family:'DM Sans',sans-serif;font-size:14px;color:var(--noir);outline:none;transition:border-color .2s;}
    .form-group input:focus{border-color:var(--noir);}
    .form-submit{width:100%;padding:15px;background:var(--noir);color:var(--blanc);font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;border:none;cursor:none;transition:background .2s;margin-top:8px;}
    .form-submit:hover{background:var(--terre);}
    .form-note{font-size:12px;color:#aaa;margin-top:14px;line-height:1.6;}

    /* VUE: DASHBOARD */
    .welcome-band{background:var(--noir);padding:28px 32px;margin-bottom:40px;display:flex;align-items:center;justify-content:space-between;}
    .welcome-band h3{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:22px;text-transform:uppercase;color:var(--blanc);letter-spacing:.04em;}
    .welcome-band p{font-size:13px;color:#555;}

    .dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:rgba(10,10,10,.08);margin-bottom:40px;}
    .dash-card{background:var(--blanc);padding:32px 28px;}
    .dash-card-title{font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--vert);margin-bottom:12px;}
    .dash-card-value{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:44px;color:var(--noir);line-height:1;}
    .dash-card-sub{font-size:13px;color:#aaa;margin-top:6px;}

    /* COMMANDES */
    .commandes-list{display:flex;flex-direction:column;gap:2px;background:rgba(10,10,10,.06);}
    .commande-item{background:var(--blanc);padding:24px 28px;display:flex;align-items:center;justify-content:space-between;transition:background .2s;}
    .commande-item:hover{background:#f0ede6;}
    .cmd-info{}
    .cmd-ref{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:18px;text-transform:uppercase;letter-spacing:.04em;color:var(--noir);}
    .cmd-date{font-size:12px;color:#aaa;margin-top:4px;}
    .cmd-produits{font-size:13px;color:#666;margin-top:6px;}
    .cmd-right{text-align:right;}
    .cmd-total{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:24px;color:var(--noir);}
    .cmd-status{display:inline-block;padding:4px 10px;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-top:6px;}
    .cmd-status.livree{background:rgba(46,92,58,.1);color:var(--vert);}
    .cmd-status.transit{background:rgba(196,122,58,.1);color:var(--terre);}

    /* INFOS PERSO */
    .info-form{max-width:560px;}
    .info-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}

    /* ADRESSES */
    .adresse-card{background:var(--blanc);border:1px solid rgba(10,10,10,.1);padding:28px;margin-bottom:2px;transition:border-color .2s;}
    .adresse-card:hover{border-color:var(--noir);}
    .adresse-label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--vert);margin-bottom:10px;}
    .adresse-text{font-size:14px;line-height:1.8;color:#666;}
    .adresse-actions{display:flex;gap:12px;margin-top:16px;}
    .adresse-btn{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:none;border:1px solid rgba(10,10,10,.15);padding:8px 16px;cursor:none;color:var(--noir);transition:all .2s;}
    .adresse-btn:hover{background:var(--noir);color:var(--blanc);border-color:var(--noir);}

    @media(max-width:960px){
      nav{padding:0 20px;}
      .nav-center .nav-link{display:none;}
      .page{grid-template-columns:1fr;}
      .sidebar{position:static;height:auto;padding:24px;}
      .content{padding:32px 24px;}
      .dash-grid{grid-template-columns:1fr 1fr;}
      .info-row{grid-template-columns:1fr;}
    }
  </style>
</head>
<body>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <nav>
    <a href="/" class="nav-logo">Empreinte</a>
    <div class="nav-center">
      <a href="/pages/chaussure" class="nav-link">La Chaussure</a>
      <a href="/pages/semelles" class="nav-link">Les Semelles</a>
      <a href="/pages/technologie" class="nav-link">Technologie</a>
      <a href="/pages/commander" class="nav-link">Produits</a>
    </div>
    <div class="nav-right">
      <a href="/pages/compte" class="nav-icon active" title="Mon compte"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></a>
      <a href="/pages/commander" class="nav-icon" title="Panier"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg><span class="cart-badge" id="navBadge" style="display:none"></span></a>
    </div>
  </nav>

  <div class="page">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar" style="display:none;">
      <div class="sidebar-user">
        <div class="user-avatar" id="userInitial">T</div>
        <div class="user-name" id="userName">Thomas R.</div>
        <div class="user-email" id="userEmail">thomas@email.com</div>
      </div>
      <nav class="sidebar-nav">
        <a href="#" class="sidebar-link active" data-view="dashboard" onclick="showView('dashboard');return false;"><span class="icon">⊞</span> Tableau de bord</a>
        <a href="#" class="sidebar-link" data-view="commandes" onclick="showView('commandes');return false;"><span class="icon">📦</span> Mes commandes</a>
        <a href="#" class="sidebar-link" data-view="infos" onclick="showView('infos');return false;"><span class="icon">👤</span> Informations</a>
        <a href="#" class="sidebar-link" data-view="adresses" onclick="showView('adresses');return false;"><span class="icon">📍</span> Mes adresses</a>
        <a href="#" class="sidebar-link" data-view="fidelite" onclick="showView('fidelite');return false;"><span class="icon">⭐</span> Fidélité</a>
      </nav>
      <div class="sidebar-logout">
        <button class="logout-btn" onclick="logout()">Se déconnecter</button>
      </div>
    </aside>

    <!-- CONTENT -->
    <main class="content">

      <!-- VUE LOGIN -->
      <div id="view-login" class="active">
        <div class="login-wrap">
          <h2 class="section-title">Mon <em>compte.</em></h2>
          <p class="section-sub">Connecte-toi pour accéder à tes commandes, adresses et informations personnelles.</p>
          <div class="form-tabs">
            <button class="form-tab active" onclick="switchTab('login')">Se connecter</button>
            <button class="form-tab" onclick="switchTab('register')">Créer un compte</button>
          </div>

          <!-- LOGIN -->
          <div id="tab-login">
            <div class="form-group"><label>Adresse e-mail</label><input type="email" id="loginEmail" placeholder="ton@email.com" /></div>
            <div class="form-group"><label>Mot de passe</label><input type="password" id="loginPassword" placeholder="••••••••" /></div>
            <button class="form-submit" onclick="doLogin()">Se connecter</button>
            <p class="form-note">Mot de passe oublié ? <a href="#" style="color:var(--terre);">Réinitialiser</a></p>
          </div>

          <!-- REGISTER -->
          <div id="tab-register" style="display:none;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
              <div class="form-group"><label>Prénom</label><input type="text" id="regPrenom" placeholder="Thomas" /></div>
              <div class="form-group"><label>Nom</label><input type="text" id="regNom" placeholder="Dupont" /></div>
            </div>
            <div class="form-group"><label>Adresse e-mail</label><input type="email" id="regEmail" placeholder="ton@email.com" /></div>
            <div class="form-group"><label>Mot de passe</label><input type="password" id="regPassword" placeholder="8 caractères minimum" /></div>
            <button class="form-submit" onclick="doRegister()">Créer mon compte</button>
          </div>
        </div>
      </div>

      <!-- VUE DASHBOARD -->
      <div id="view-dashboard" class="view-section">
        <h2 class="section-title">Tableau de <em>bord.</em></h2>
        <p class="section-sub">Bienvenue dans ton espace EMPREINTE.</p>
        <div class="welcome-band">
          <div>
            <h3 id="welcomeName">Bonjour, Thomas 👋</h3>
            <p>Dernière connexion : aujourd'hui</p>
          </div>
        </div>
        <div class="dash-grid">
          <div class="dash-card">
            <div class="dash-card-title">Commandes</div>
            <div class="dash-card-value">3</div>
            <div class="dash-card-sub">dont 1 en cours de livraison</div>
          </div>
          <div class="dash-card">
            <div class="dash-card-title">Points fidélité</div>
            <div class="dash-card-value">240</div>
            <div class="dash-card-sub">= 24€ de réduction disponibles</div>
          </div>
          <div class="dash-card">
            <div class="dash-card-title">Km parcourus</div>
            <div class="dash-card-value">847</div>
            <div class="dash-card-sub">avec ta paire EMPREINTE</div>
          </div>
          <div class="dash-card">
            <div class="dash-card-title">Semelles utilisées</div>
            <div class="dash-card-value">3</div>
            <div class="dash-card-sub">Route, Chemin Sec, Boue</div>
          </div>
        </div>
      </div>

      <!-- VUE COMMANDES -->
      <div id="view-commandes" class="view-section">
        <h2 class="section-title">Mes <em>commandes.</em></h2>
        <p class="section-sub">Historique de toutes tes commandes EMPREINTE.</p>
        <div class="commandes-list">
          <div class="commande-item">
            <div class="cmd-info">
              <div class="cmd-ref">#EMP-2025-0042</div>
              <div class="cmd-date">12 avril 2025</div>
              <div class="cmd-produits">Kit Complet EMPREINTE — Taille 42</div>
            </div>
            <div class="cmd-right">
              <div class="cmd-total">180€</div>
              <div class="cmd-status transit">En transit</div>
            </div>
          </div>
          <div class="commande-item">
            <div class="cmd-info">
              <div class="cmd-ref">#EMP-2025-0019</div>
              <div class="cmd-date">3 février 2025</div>
              <div class="cmd-produits">Semelle Boue &amp; Technique — ×2</div>
            </div>
            <div class="cmd-right">
              <div class="cmd-total">58€</div>
              <div class="cmd-status livree">Livrée</div>
            </div>
          </div>
          <div class="commande-item">
            <div class="cmd-info">
              <div class="cmd-ref">#EMP-2024-0087</div>
              <div class="cmd-date">18 novembre 2024</div>
              <div class="cmd-produits">Chaussure seule — Taille 42 + Pochette Dirty-Bag</div>
            </div>
            <div class="cmd-right">
              <div class="cmd-total">139€</div>
              <div class="cmd-status livree">Livrée</div>
            </div>
          </div>
        </div>
      </div>

      <!-- VUE INFOS -->
      <div id="view-infos" class="view-section">
        <h2 class="section-title">Mes <em>informations.</em></h2>
        <p class="section-sub">Modifie tes informations personnelles et ton mot de passe.</p>
        <div class="info-form">
          <div class="info-row">
            <div class="form-group"><label>Prénom</label><input type="text" value="Thomas" /></div>
            <div class="form-group"><label>Nom</label><input type="text" value="Renaud" /></div>
          </div>
          <div class="form-group"><label>Adresse e-mail</label><input type="email" value="thomas.renaud@email.com" /></div>
          <div class="form-group"><label>Téléphone</label><input type="tel" placeholder="+33 6 00 00 00 00" /></div>
          <div class="form-group" style="margin-top:32px;padding-top:32px;border-top:1px solid rgba(10,10,10,.08);">
            <label>Nouveau mot de passe</label><input type="password" placeholder="Laisser vide pour ne pas modifier" />
          </div>
          <div class="form-group"><label>Confirmer le mot de passe</label><input type="password" placeholder="••••••••" /></div>
          <button class="form-submit" style="max-width:200px;" onclick="showToast('Informations mises à jour')">Enregistrer</button>
        </div>
      </div>

      <!-- VUE ADRESSES -->
      <div id="view-adresses" class="view-section">
        <h2 class="section-title">Mes <em>adresses.</em></h2>
        <p class="section-sub">Gère tes adresses de livraison et de facturation.</p>
        <div class="adresse-card">
          <div class="adresse-label">Adresse principale — Livraison</div>
          <p class="adresse-text">Thomas Renaud<br>42 rue des Coureurs<br>69006 Lyon<br>France</p>
          <div class="adresse-actions">
            <button class="adresse-btn">Modifier</button>
            <button class="adresse-btn">Supprimer</button>
          </div>
        </div>
        <div style="margin-top:2px;">
          <button class="form-submit" style="max-width:220px;margin-top:20px;" onclick="showToast('Fonctionnalité disponible prochainement')">+ Ajouter une adresse</button>
        </div>
      </div>

      <!-- VUE FIDELITE -->
      <div id="view-fidelite" class="view-section">
        <h2 class="section-title">Programme <em>fidélité.</em></h2>
        <p class="section-sub">Chaque euro dépensé te rapporte 1 point. 100 points = 10€ de réduction.</p>
        <div class="dash-grid" style="max-width:600px;margin-bottom:40px;">
          <div class="dash-card">
            <div class="dash-card-title">Mes points</div>
            <div class="dash-card-value">240</div>
            <div class="dash-card-sub">= 24€ disponibles</div>
          </div>
          <div class="dash-card">
            <div class="dash-card-title">Statut</div>
            <div class="dash-card-value" style="font-size:28px;">Trail Runner</div>
            <div class="dash-card-sub">Prochain palier : Elite à 500pts</div>
          </div>
        </div>
        <div style="background:var(--noir);padding:32px;max-width:600px;">
          <p style="font-size:13px;color:#555;line-height:1.8;">
            <span style="color:var(--vert);font-weight:600;">Statut Trail Runner</span> — 100 à 499 points<br>
            Avantages : accès aux ventes privées, −10% sur les semelles, livraison prioritaire.
          </p>
        </div>
      </div>

    </main>
  </div>

  <div id="toast" style="position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:var(--noir);color:var(--blanc);font-size:13px;letter-spacing:.06em;padding:14px 28px;z-index:9999;opacity:0;transition:opacity .3s;pointer-events:none;"></div>

  <script>
    const cursor=document.getElementById('cursor'),ring=document.getElementById('cursorRing');
    let mx=0,my=0,rx=0,ry=0;
    document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});
    function anim(){cursor.style.left=mx+'px';cursor.style.top=my+'px';rx+=(mx-rx)*.14;ry+=(my-ry)*.14;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(anim);}
    anim();
    document.querySelectorAll('a,button,input').forEach(el=>{
      el.addEventListener('mouseenter',()=>{cursor.style.width='6px';cursor.style.height='6px';ring.style.width='52px';ring.style.height='52px';});
      el.addEventListener('mouseleave',()=>{cursor.style.width='10px';cursor.style.height='10px';ring.style.width='36px';ring.style.height='36px';});
    });

    function showToast(msg){
      const t=document.getElementById('toast');
      t.textContent=msg;t.style.opacity='1';
      setTimeout(()=>t.style.opacity='0',2500);
    }

    // Auth simulation
    const user=JSON.parse(localStorage.getItem('empreinte-user')||'null');
    if(user){showLoggedIn(user);}

    function switchTab(tab){
      document.querySelectorAll('.form-tab').forEach((b,i)=>b.classList.toggle('active',i===(tab==='login'?0:1)));
      document.getElementById('tab-login').style.display=tab==='login'?'block':'none';
      document.getElementById('tab-register').style.display=tab==='register'?'block':'none';
    }

    function doLogin(){
      const email=document.getElementById('loginEmail').value;
      const pass=document.getElementById('loginPassword').value;
      if(!email||!pass){showToast('Remplis tous les champs');return;}
      const u={name:'Thomas R.',email,prenom:'Thomas'};
      localStorage.setItem('empreinte-user',JSON.stringify(u));
      showLoggedIn(u);
    }

    function doRegister(){
      const prenom=document.getElementById('regPrenom').value;
      const nom=document.getElementById('regNom').value;
      const email=document.getElementById('regEmail').value;
      if(!prenom||!email){showToast('Remplis tous les champs');return;}
      const u={name:prenom+' '+nom.charAt(0)+'.',email,prenom};
      localStorage.setItem('empreinte-user',JSON.stringify(u));
      showLoggedIn(u);
    }

    function showLoggedIn(u){
      document.getElementById('view-login').classList.remove('active');
      document.getElementById('sidebar').style.display='block';
      document.getElementById('userName').textContent=u.name;
      document.getElementById('userEmail').textContent=u.email;
      document.getElementById('userInitial').textContent=(u.prenom||u.name).charAt(0).toUpperCase();
      document.getElementById('welcomeName').textContent='Bonjour, '+(u.prenom||u.name)+' 👋';
      showView('dashboard');
    }

    function logout(){
      localStorage.removeItem('empreinte-user');
      document.getElementById('sidebar').style.display='none';
      document.querySelectorAll('.view-section').forEach(v=>v.classList.remove('active'));
      document.getElementById('view-login').classList.add('active');
    }

    function showView(id){
      document.querySelectorAll('.view-section').forEach(v=>v.classList.remove('active'));
      document.getElementById('view-'+id).classList.add('active');
      document.querySelectorAll('.sidebar-link').forEach(l=>{
        l.classList.toggle('active',l.dataset.view===id);
      });
    }
  </script>
</body>
</html>
