      </a>
      <div class="sn-card current">
        <div class="sn-num">02</div>
        <div class="sn-name">Chemin Sec</div>
        <div class="sn-terrain">Forêt · Terre · Graviers</div>
        <div class="sn-price">29€</div>
      </div>
      <a href="/pages/commander" class="sn-card">
        <div class="sn-num">03</div>
        <div class="sn-name">Boue &amp; Technique</div>
        <div class="sn-terrain">Montagne · Herbe · Marécages</div>
        <div class="sn-price">29€</div>
      </a>
    </div>
  </section>

  <script>
    const cursor=document.getElementById('cursor'),ring=document.getElementById('cursorRing');
    let mx=0,my=0,rx=0,ry=0;
    document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});
    function anim(){cursor.style.left=mx+'px';cursor.style.top=my+'px';rx+=(mx-rx)*.14;ry+=(my-ry)*.14;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(anim);}
    anim();
    document.querySelectorAll('a,button').forEach(el=>{
      el.addEventListener('mouseenter',()=>{cursor.style.width='6px';cursor.style.height='6px';ring.style.width='52px';ring.style.height='52px';});
      el.addEventListener('mouseleave',()=>{cursor.style.width='10px';cursor.style.height='10px';ring.style.width='36px';ring.style.height='36px';});
    });
    function setImg(el,src){document.getElementById('mainImg').src=src;document.querySelectorAll('.thumb').forEach(t=>t.classList.remove('active'));el.classList.add('active');}
    let selectedSize=null,qty=1;
    function selectSize(el){if(el.classList.contains('soldout'))return;document.querySelectorAll('.size-btn').forEach(b=>b.classList.remove('active'));el.classList.add('active');selectedSize=el.textContent;document.getElementById('sizeLabel').textContent='Taille '+selectedSize;}
    function changeQtyProd(d){qty=Math.max(1,qty+d);document.getElementById('prodQty').textContent=qty;}
    function getCart(){return JSON.parse(localStorage.getItem('empreinte-cart')||'[]');}
    function saveCart(c){localStorage.setItem('empreinte-cart',JSON.stringify(c));}
    function addToCartProd(){
      if(!selectedSize){showToast('Sélectionne une taille');return;}
      const name='Semelle Chemin Sec';
      const variant='Taille '+selectedSize;
      const cart=getCart();const key=name+'|'+variant;
      const ex=cart.find(i=>i.key===key);
      if(ex){ex.qty+=qty;}else{cart.push({key,name,variant,price:29,qty,img:'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=120&q=70&fit=crop'});}
      saveCart(cart);renderCart();openCart();
    }
    function buyNow(){addToCartProd();setTimeout(()=>window.location.href='/pages/commander',400);}
    function openCart(){document.getElementById('cartOverlay').classList.add('open');document.getElementById('cartPanel').classList.add('open');renderCart();}
    function closeCart(){document.getElementById('cartOverlay').classList.remove('open');document.getElementById('cartPanel').classList.remove('open');}
    function renderCart(){
      const cart=getCart();
      const total=cart.reduce((s,i)=>s+i.price*i.qty,0);
      const count=cart.reduce((s,i)=>s+i.qty,0);
      document.getElementById('cartTotal').textContent=total+'€';
      document.getElementById('navBadge').textContent=count;
      document.getElementById('cartCount').textContent=count>0?'('+count+')':'';
      const container=document.getElementById('cartItems');
      if(cart.length===0){container.innerHTML='<div class="cart-empty">Ton panier est vide.</div>';return;}
      container.innerHTML=cart.map((item,idx)=>`<div class="cart-item"><img class="cart-item-thumb" src="${item.img||''}" alt=""/><div class="cart-item-info"><div class="cart-item-name">${item.name}</div><div class="cart-item-variant">${item.variant||''}</div><div class="cart-item-price">${item.price}€</div><div class="cart-item-qty"><button class="cqty-btn" onclick="cQty(${idx},-1)">−</button><span class="cqty-num">${item.qty}</span><button class="cqty-btn" onclick="cQty(${idx},1)">+</button></div></div></div>`).join('');
    }
    function cQty(idx,d){const cart=getCart();cart[idx].qty+=d;if(cart[idx].qty<=0)cart.splice(idx,1);saveCart(cart);renderCart();}
    function checkout(){showToast('Redirection vers le paiement...');setTimeout(closeCart,1500);}
    function toggleAccordion(header){const item=header.parentElement;const wasOpen=item.classList.contains('open');document.querySelectorAll('.accordion-item').forEach(i=>i.classList.remove('open'));if(!wasOpen)item.classList.add('open');}
    function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.opacity='1';setTimeout(()=>t.style.opacity='0',2500);}
    renderCart();
  </script>
</body>
</html>
