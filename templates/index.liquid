<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,300;0,400;0,700;0,800;0,900;1,700;1,900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --noir: #0A0A0A;
      --blanc: #F5F2ED;
      --terre: #C47A3A;
      --vert: #2E5C3A;
      --gris: #888;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--blanc);
      color: var(--noir);
      overflow-x: hidden;
      cursor: none;
    }

    /* ─── CURSOR ────────────────────────────────────────── */
    .cursor {
      width: 10px; height: 10px;
      background: var(--terre);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9999;
      transform: translate(-50%, -50%);
      transition: width 0.2s, height 0.2s, background 0.2s;
    }
    .cursor-ring {
      width: 36px; height: 36px;
      border: 1px solid rgba(196,122,58,0.5);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9998;
      transform: translate(-50%, -50%);
      transition: all 0.12s ease-out;
    }

    /* ─── NAV ────────────────────────────────────────────── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 500;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 40px; height: 64px;
      mix-blend-mode: difference;
    }

    .nav-logo {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: 20px;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--blanc); text-decoration: none;
    }

    .nav-center{display:flex;align-items:center;gap:32px;}
    .nav-link{font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--blanc);text-decoration:none;opacity:.7;transition:opacity .2s;}
    .nav-link:hover,.nav-link.active{opacity:1;}
    .nav-right{display:flex;align-items:center;gap:4px;}
    .nav-icon{width:40px;height:40px;display:flex;align-items:center;justify-content:center;color:rgba(245,242,237,.6);text-decoration:none;transition:color .2s;position:relative;}
    .nav-icon:hover{color:var(--blanc);}
    .cart-badge{background:var(--terre);color:#fff;border-radius:50%;width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;font-size:8px;font-weight:900;position:absolute;top:5px;right:3px;}

    /* ─── HERO ───────────────────────────────────────────── */
    .hero {
      height: 100vh; position: relative;
      overflow: hidden; display: flex; align-items: flex-end;
    }

    .hero-img {
      position: absolute; inset: 0;
      background-image: url('https://images.unsplash.com/photo-1551632811-561732d1e306?w=1800&q=85&fit=crop');
      background-size: cover; background-position: center 30%;
      transform: scale(1.05);
      transition: transform 8s ease-out;
    }
    .hero-img.loaded { transform: scale(1); }

    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0.1) 60%, transparent 100%);
    }

    .hero-content {
      position: relative; z-index: 2;
      padding: 0 40px 64px;
      width: 100%;
    }

    .hero-eyebrow {
      font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--terre);
      margin-bottom: 16px;
      display: flex; align-items: center; gap: 12px;
    }
    .hero-eyebrow::before {
      content: ''; display: block;
      width: 28px; height: 1px; background: var(--terre);
    }

    .hero h1 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-style: italic;
      font-size: clamp(88px, 14vw, 200px);
      line-height: 0.88; text-transform: uppercase;
      color: var(--blanc); letter-spacing: -0.02em;
      margin-bottom: 40px;
    }

    .hero-bottom {
      display: flex; align-items: flex-end;
      justify-content: space-between;
    }

    .hero-desc {
      font-size: 15px; color: rgba(245,242,237,0.6);
      max-width: 340px; line-height: 1.7; font-weight: 300;
    }

    .hero-cta {
      display: flex; align-items: center; gap: 16px;
    }
    .btn-hero {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800; font-size: 13px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--noir);
      background: var(--blanc); padding: 14px 32px;
      text-decoration: none; transition: background 0.2s;
    }
    .btn-hero:hover { background: var(--terre); color: var(--blanc); }

    .scroll-hint {
      position: absolute; right: 40px; top: 50%;
      transform: translateY(-50%) rotate(90deg);
      font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(245,242,237,0.35); white-space: nowrap;
    }

    /* ─── TICKER ─────────────────────────────────────────── */
    .ticker {
      background: var(--noir); overflow: hidden;
      padding: 14px 0; border-top: 1px solid #1a1a1a;
    }
    .ticker-track {
      display: flex; gap: 0;
      animation: ticker 24s linear infinite;
      width: max-content;
    }
    .ticker-item {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700; font-size: 13px; letter-spacing: 0.12em;
      text-transform: uppercase; color: rgba(245,242,237,0.4);
      padding: 0 40px; white-space: nowrap;
    }
    .ticker-item span { color: var(--terre); margin-right: 40px; }
    @keyframes ticker {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ─── INTRO SPLIT ─────────────────────────────────────── */
    .intro {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 90vh;
    }
    .intro-left {
      background: var(--blanc);
      padding: 100px 64px;
      display: flex; flex-direction: column; justify-content: center;
    }
    .intro-left .label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--vert);
      margin-bottom: 28px;
    }
    .intro-left h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: clamp(52px, 5vw, 76px);
      text-transform: uppercase; line-height: 0.95;
      color: var(--noir); margin-bottom: 32px;
    }
    .intro-left h2 em { font-style: italic; color: var(--terre); }
    .intro-left p {
      font-size: 16px; line-height: 1.8; color: #555;
      margin-bottom: 16px; font-weight: 300;
    }
    .intro-stats {
      display: flex; gap: 0; margin-top: 48px;
      border-top: 1px solid rgba(10,10,10,0.1);
    }
    .istat {
      flex: 1; padding: 28px 0; padding-right: 24px;
      border-right: 1px solid rgba(10,10,10,0.1);
    }
    .istat:last-child { border-right: none; padding-right: 0; padding-left: 24px; }
    .istat-n {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: 48px; color: var(--noir); line-height: 1;
    }
    .istat-l { font-size: 11px; color: var(--gris); margin-top: 4px; letter-spacing: 0.06em; }

    .intro-right {
      position: relative; overflow: hidden;
    }
    .intro-right img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      display: block;
      transition: transform 0.6s ease;
    }
    .intro-right:hover img { transform: scale(1.04); }

    /* ─── FULL PHOTO ─────────────────────────────────────── */
    .full-photo {
      height: 70vh; position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .full-photo img {
      position: absolute; inset: 0;
      width: 100%; height: 100%; object-fit: cover;
      object-position: center 40%;
    }
    .full-photo-overlay {
      position: absolute; inset: 0;
      background: rgba(10,10,10,0.45);
    }
    .full-photo-text {
      position: relative; z-index: 2;
      text-align: center;
    }
    .full-photo-text h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-style: italic;
      font-size: clamp(64px, 10vw, 140px);
      text-transform: uppercase; color: var(--blanc);
      line-height: 0.9; letter-spacing: -0.01em;
    }
    .full-photo-text h2 span { color: var(--terre); }

    /* ─── MÉCANISME ───────────────────────────────────────── */
    .mecanism {
      background: var(--noir); padding: 120px 64px;
    }
    .mecanism-header {
      display: flex; align-items: baseline;
      justify-content: space-between; margin-bottom: 80px;
      border-bottom: 1px solid #1e1e1e; padding-bottom: 32px;
    }
    .mecanism-header h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: clamp(48px, 6vw, 80px);
      text-transform: uppercase; color: var(--blanc); line-height: 0.95;
    }
    .mecanism-header h2 em { font-style: italic; color: var(--terre); }
    .mecanism-header p {
      font-size: 14px; color: #555; max-width: 300px;
      line-height: 1.7; text-align: right;
    }

    .steps {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1px; background: #1a1a1a;
    }
    .step {
      background: var(--noir); padding: 48px 36px;
      transition: background 0.3s;
    }
    .step:hover { background: #111; }
    .step-n {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 300; font-size: 72px; color: #1e1e1e;
      line-height: 1; margin-bottom: 24px;
    }
    .step-title {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800; font-size: 20px; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--blanc); margin-bottom: 12px;
    }
    .step-desc {
      font-size: 13px; line-height: 1.8; color: #555;
    }
    .step-clic {
      margin-top: 24px;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: 18px;
      letter-spacing: 0.15em; color: var(--terre);
    }

    /* ─── SEMELLES ───────────────────────────────────────── */
    .semelles { background: var(--blanc); }
    .semelles-header {
      padding: 100px 64px 64px;
      display: flex; align-items: flex-end; justify-content: space-between;
      border-bottom: 1px solid rgba(10,10,10,0.08);
    }
    .semelles-header h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: clamp(52px, 7vw, 96px);
      text-transform: uppercase; line-height: 0.9; color: var(--noir);
    }
    .semelles-header h2 em { font-style: italic; color: var(--terre); }
    .semelles-header p {
      font-size: 14px; color: var(--gris); max-width: 260px;
      line-height: 1.7; text-align: right;
    }

    .semelles-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: rgba(10,10,10,0.08);
    }

    .semelle {
      background: var(--blanc); overflow: hidden;
      position: relative; cursor: none;
    }

    .semelle-photo {
      height: 420px; overflow: hidden; position: relative;
    }
    .semelle-photo img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      display: block;
      transition: transform 0.7s ease;
    }
    .semelle:hover .semelle-photo img { transform: scale(1.06); }

    .semelle-photo-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(10,10,10,0.6) 0%, transparent 50%);
    }

    .semelle-num {
      position: absolute; top: 20px; left: 24px;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 300; font-size: 13px; letter-spacing: 0.15em;
      color: rgba(245,242,237,0.6); text-transform: uppercase;
    }

    .semelle-tag-photo {
      position: absolute; bottom: 20px; left: 24px;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800; font-size: 28px; text-transform: uppercase;
      color: var(--blanc); letter-spacing: 0.02em; line-height: 1;
    }

    .semelle-body {
      padding: 32px 28px 36px;
      border-bottom: 1px solid rgba(10,10,10,0.08);
    }
    .semelle-body p {
      font-size: 13px; line-height: 1.8; color: #666;
      margin-bottom: 24px;
    }
    .semelle-specs {
      display: flex; flex-direction: column; gap: 0;
    }
    .sspec {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 0; border-bottom: 1px solid rgba(10,10,10,0.06);
      font-size: 12px;
    }
    .sspec:last-child { border-bottom: none; }
    .sspec-k { color: #aaa; text-transform: uppercase; letter-spacing: 0.07em; }
    .sspec-v { font-weight: 600; color: var(--noir); }

    .semelle-foot {
      padding: 20px 28px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .semelle-weight-tag {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 13px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--vert);
    }
    .semelle-add {
      font-size: 11px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--noir);
      background: none; border: 1px solid rgba(10,10,10,0.2);
      padding: 8px 16px; cursor: none; transition: all 0.2s;
    }
    .semelle-add:hover { background: var(--noir); color: var(--blanc); }

    /* ─── MATERIAUX ──────────────────────────────────────── */
    .materiaux {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 80vh;
    }
    .mat-photo {
      position: relative; overflow: hidden;
    }
    .mat-photo img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      display: block;
    }
    .mat-content {
      background: var(--noir); padding: 100px 64px;
      display: flex; flex-direction: column; justify-content: center;
    }
    .mat-content .label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--vert);
      margin-bottom: 28px;
    }
    .mat-content h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: clamp(48px, 4.5vw, 68px);
      text-transform: uppercase; line-height: 0.95; color: var(--blanc);
      margin-bottom: 56px;
    }
    .mat-content h2 em { font-style: italic; color: var(--terre); }

    .mat-list { display: flex; flex-direction: column; gap: 0; }
    .mat-item {
      padding: 28px 0; border-top: 1px solid #1a1a1a;
    }
    .mat-item:last-child { border-bottom: 1px solid #1a1a1a; }
    .mat-item-top {
      display: flex; align-items: baseline;
      justify-content: space-between; margin-bottom: 10px;
    }
    .mat-name {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800; font-size: 22px; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--terre);
    }
    .mat-part {
      font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
      color: #444;
    }
    .mat-desc {
      font-size: 13px; line-height: 1.8; color: #555;
    }
    .mat-highlight {
      margin-top: 10px; font-size: 12px; color: var(--vert);
      font-weight: 500; letter-spacing: 0.04em;
    }

    /* ─── FULL PHOTO 2 ───────────────────────────────────── */
    .mid-photo {
      height: 60vh; position: relative; overflow: hidden;
      display: flex; align-items: center;
    }
    .mid-photo img {
      position: absolute; inset: 0;
      width: 100%; height: 100%; object-fit: cover;
      object-position: center 20%;
    }
    .mid-photo-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(90deg, rgba(10,10,10,0.75) 0%, transparent 60%);
    }
    .mid-photo-content {
      position: relative; z-index: 2; padding: 0 64px;
    }
    .mid-photo-content p {
      font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--terre); margin-bottom: 16px;
    }
    .mid-photo-content h3 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-style: italic;
      font-size: clamp(48px, 6vw, 84px);
      text-transform: uppercase; color: var(--blanc); line-height: 0.95;
      max-width: 640px;
    }

    /* ─── PRICING ────────────────────────────────────────── */
    .pricing { padding: 120px 64px; background: var(--blanc); }
    .pricing-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      margin-bottom: 72px; border-bottom: 1px solid rgba(10,10,10,0.1);
      padding-bottom: 32px;
    }
    .pricing-header h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: clamp(48px, 6vw, 84px);
      text-transform: uppercase; line-height: 0.9; color: var(--noir);
    }
    .pricing-header h2 em { font-style: italic; color: var(--terre); }
    .pricing-header p { font-size: 13px; color: var(--gris); max-width: 240px; text-align: right; line-height: 1.6; }

    .pricing-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: rgba(10,10,10,0.1);
    }
    .pcard {
      background: var(--blanc); padding: 48px 36px;
      transition: background 0.3s;
    }
    .pcard.featured { background: var(--noir); }
    .pcard:not(.featured):hover { background: #f0ede6; }

    .pcard-badge {
      display: inline-block; background: var(--terre);
      color: var(--blanc); font-size: 9px; font-weight: 800;
      letter-spacing: 0.14em; text-transform: uppercase;
      padding: 3px 10px; margin-bottom: 20px;
    }

    .pcard-name {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: 28px; text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--noir); margin-bottom: 8px;
    }
    .pcard.featured .pcard-name { color: var(--blanc); }

    .pcard-desc {
      font-size: 13px; line-height: 1.7; color: #888; margin-bottom: 32px;
    }
    .pcard.featured .pcard-desc { color: #555; }

    .pcard-price {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-size: 72px; line-height: 1;
      color: var(--noir); margin-bottom: 4px;
    }
    .pcard.featured .pcard-price { color: var(--blanc); }
    .pcard-unit { font-size: 11px; color: #aaa; letter-spacing: 0.08em; margin-bottom: 36px; text-transform: uppercase; }

    .pcard-list { list-style: none; margin-bottom: 36px; display: flex; flex-direction: column; gap: 10px; }
    .pcard-list li { font-size: 13px; color: #666; display: flex; align-items: center; gap: 10px; }
    .pcard-list li::before { content: '—'; color: var(--terre); font-weight: 700; flex-shrink: 0; }
    .pcard.featured .pcard-list li { color: #555; }

    .pcard-btn {
      width: 100%; padding: 14px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 13px; font-weight: 800; letter-spacing: 0.1em;
      text-transform: uppercase; cursor: none;
      transition: all 0.2s; border: none;
    }
    .pcard:not(.featured) .pcard-btn {
      background: var(--noir); color: var(--blanc);
    }
    .pcard:not(.featured) .pcard-btn:hover { background: var(--terre); }
    .pcard.featured .pcard-btn {
      background: var(--terre); color: var(--blanc);
    }
    .pcard.featured .pcard-btn:hover { background: #a8642e; }

    /* ─── VALEURS ────────────────────────────────────────── */
    .valeurs {
      background: var(--noir); padding: 100px 64px;
      display: grid; grid-template-columns: 1fr 1fr 1fr;
      gap: 1px; background: #111;
    }
    .valeur {
      background: var(--noir); padding: 64px 48px;
    }
    .valeur-num {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 300; font-size: 60px; line-height: 1;
      color: #1a1a1a; margin-bottom: 20px;
    }
    .valeur-title {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800; font-size: 20px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--blanc); margin-bottom: 12px;
    }
    .valeur-desc { font-size: 13px; line-height: 1.8; color: #555; }

    /* ─── CTA FINAL ──────────────────────────────────────── */
    .cta-final {
      height: 65vh; position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .cta-final img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; object-position: center 35%;
    }
    .cta-final-overlay {
      position: absolute; inset: 0;
      background: rgba(10,10,10,0.6);
    }
    .cta-final-content {
      position: relative; z-index: 2;
      text-align: center;
    }
    .cta-final-content h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900; font-style: italic;
      font-size: clamp(56px, 9vw, 120px);
      text-transform: uppercase; color: var(--blanc);
      line-height: 0.9; margin-bottom: 40px;
    }
    .cta-final-content h2 em { color: var(--terre); font-style: normal; }
    .btn-cta {
      display: inline-block;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800; font-size: 14px; letter-spacing: 0.12em;
      text-transform: uppercase; text-decoration: none;
      background: var(--blanc); color: var(--noir);
      padding: 16px 48px; transition: all 0.2s;
    }
    .btn-cta:hover { background: var(--terre); color: var(--blanc); }

    /* ─── FOOTER ─────────────────────────────────────────── */
    footer {
      background: var(--noir); padding: 80px 64px 48px;
      border-top: 1px solid #1a1a1a;
    }
    .footer-top {
